# FinIntel Environment Configuration Template
# Safe placeholder values only. DO NOT commit actual secrets or credentials.

# System & Environment
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# Web Application (apps/web)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_OIDC_ISSUER_URL=http://localhost:8081/realms/finintel
NEXT_PUBLIC_OIDC_CLIENT_ID=finintel-web-client

# Core API Service (services/api)
API_PORT=8080
API_HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Provider-Neutral OIDC Configuration (Go API Resource Server)
OIDC_ISSUER_URL=http://localhost:8081/realms/finintel
OIDC_AUDIENCE=finintel-api
OIDC_JWKS_URL=http://localhost:8081/realms/finintel/protocol/openid-connect/certs

# Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?sslmode=[mode]
DATABASE_URL=postgresql://finintel_user:placeholder_pass@localhost:5432/finintel_dev?sslmode=disable
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5

# Intelligence Service (services/intelligence)
INTELLIGENCE_SERVICE_URL=http://localhost:8000
INTELLIGENCE_API_KEY=placeholder_internal_intelligence_key

# Background Worker Service (services/worker)
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=1000

# Telemetry & Correlation
ENABLE_TELEMETRY=false
TELEMETRY_EXPORTER_ENDPOINT=http://localhost:4318
