# FinIntel Environment Configuration Template
# Safe placeholder values only. DO NOT commit actual secrets or credentials.

# ------------------------------------------------------------------------------
# 1. CURRENTLY CONSUMED CONFIGURATION (Milestone 1 Core API Implementation)
# ------------------------------------------------------------------------------

# System & Environment (consumed in services/api/internal/config/config.go)
APP_ENV=development
API_PORT=8080
API_HOST=0.0.0.0
LOG_LEVEL=info

# Database Connection (consumed in services/api/internal/config/config.go)
# Format: postgres://[user]:[password]@[host]:[port]/[dbname]?sslmode=[mode]
DATABASE_URL=postgres://finintel_user:placeholder_pass@localhost:5432/finintel_dev?sslmode=disable
DATABASE_MAX_CONNS=25

# ------------------------------------------------------------------------------
# 2. RESERVED / DEFERRED CONFIGURATION (Future Milestones)
# ------------------------------------------------------------------------------

# Web Application URLs (Milestone 2 - Web Authentication & API Integration)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Cross-Origin Resource Sharing (Milestone 2 - Core API CORS Middleware)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Provider-Neutral OIDC Authentication (Milestone 2)
NEXT_PUBLIC_OIDC_ISSUER_URL=http://localhost:8081/realms/finintel
NEXT_PUBLIC_OIDC_CLIENT_ID=finintel-web-client
OIDC_ISSUER_URL=http://localhost:8081/realms/finintel
OIDC_AUDIENCE=finintel-api
OIDC_JWKS_URL=http://localhost:8081/realms/finintel/protocol/openid-connect/certs

# Intelligence Service (Milestone 7)
INTELLIGENCE_SERVICE_URL=http://localhost:8000
INTELLIGENCE_API_KEY=placeholder_internal_intelligence_key

# Background Worker Service (Milestone 4)
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=1000

# Telemetry & Distributed Tracing (Milestone 8)
ENABLE_TELEMETRY=false
TELEMETRY_EXPORTER_ENDPOINT=http://localhost:4318
