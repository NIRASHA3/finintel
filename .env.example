# FinIntel Environment Configuration Template (Track 1 Security Hardened)
# Safe placeholder values only. DO NOT commit actual secrets or production credentials.

# ------------------------------------------------------------------------------
# 1. CORE API SERVER CONFIGURATION
# ------------------------------------------------------------------------------
APP_ENV=development
API_PORT=8080
API_HOST=0.0.0.0
LOG_LEVEL=info

# Core API PostgreSQL Runtime Connection (Connects as dev_app_login in role finintel_app)
DATABASE_URL=postgres://dev_app_login:app_dev_pass@localhost:5432/finintel_dev?sslmode=disable
DATABASE_MAX_CONNS=25

# Core API OIDC JWT Validation
OIDC_ISSUER_URL=https://auth.finintel.internal
OIDC_AUDIENCE=finintel-api
OIDC_JWKS_URL=https://auth.finintel.internal/.well-known/jwks.json
OIDC_ALLOWED_ALGS=RS256

# CORS (Trusted origins for direct server-to-server or browser-to-BFF calls)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. NEXT.JS BFF SERVER CONFIGURATION (Server-Only, No NEXT_PUBLIC_)
# ------------------------------------------------------------------------------

# BFF Database Connection (Connects as dev_bff_login in role finintel_bff to bff schema)
BFF_DATABASE_URL=postgres://dev_bff_login:bff_dev_pass@localhost:5432/finintel_dev?sslmode=disable

# Upstream Core API Base URL
CORE_API_URL=http://localhost:8080

# BFF OIDC Client Configuration
OIDC_CLIENT_ID=finintel-web-bff
OIDC_CLIENT_SECRET=placeholder_bff_client_secret_32chars

# Application Public Origin
APPLICATION_ORIGIN=http://localhost:3000

# Session Cryptographic Keyring (AES-256-GCM 32-byte hex string)
SESSION_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# Session Expiration Controls (in seconds)
SESSION_IDLE_TIMEOUT_SECONDS=900
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800

# ------------------------------------------------------------------------------
# 3. RESERVED / DEFERRED TRACK CONFIGURATION (Track 2-5)
# ------------------------------------------------------------------------------
INTELLIGENCE_SERVICE_URL=http://localhost:8000
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=1000
ENABLE_TELEMETRY=false
