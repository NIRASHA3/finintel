# Safe local placeholders only. Never commit real database URLs or client secrets.

# Runtime
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=info

# Local PostgreSQL. Neon production URLs must use TLS (sslmode=require).
DATABASE_URL=postgres://finintel_user:placeholder_pass@localhost:5432/finintel_dev?sslmode=disable
DATABASE_MAX_CONNS=10
POSTGRES_PASSWORD=finintel_local_only
POSTGRES_PORT=5432

# Browser-facing endpoints
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Authentication. AUTH_DEV_MODE must be false outside local development.
AUTH_DEV_MODE=true
NEXT_PUBLIC_OIDC_ISSUER_URL=http://localhost:8081/realms/finintel
NEXT_PUBLIC_OIDC_CLIENT_ID=finintel-web-client
OIDC_ISSUER_URL=http://localhost:8081/realms/finintel
OIDC_AUDIENCE=finintel-api
OIDC_JWKS_URL=http://localhost:8081/realms/finintel/protocol/openid-connect/certs

# Internal intelligence service
INTELLIGENCE_SERVICE_URL=http://localhost:8000
INTELLIGENCE_API_KEY=replace_with_local_only_value

# Planned worker (not currently deployed)
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=1000

# Optional telemetry
ENABLE_TELEMETRY=false
TELEMETRY_EXPORTER_ENDPOINT=http://localhost:4318
