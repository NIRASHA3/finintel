# Git Line Ending & Text Handling Policy
# Set default behavior to automatic text normalization with LF line endings.

* text=auto eol=lf

# Explicit text file types
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.go text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.css text eol=lf
*.html text eol=lf
*.env* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Binary file types
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
